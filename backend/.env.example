# NyayaAI Environment Configurations

PROJECT_NAME="NyayaAI"
API_V1_STR="/api/v1"
ENVIRONMENT="local"

# MongoDB Configuration
MONGODB_URL="mongodb://localhost:27017"
MONGODB_DB_NAME="nyaya_ai"

# Qdrant Vector DB Configuration
# For local Qdrant, we use localhost. If running memory-only, this can be omitted.
QDRANT_HOST="localhost"
QDRANT_PORT=6333
QDRANT_API_KEY=""

# LLM Configuration (For future milestones)
# GEMINI_API_KEY="your-gemini-api-key-here"
# GROQ_API_KEY="your-groq-api-key-here"
